# The anti-phishing confirm screen must not be framable (clickjacking);
# the meta CSP cannot express frame-ancestors, headers can. One block per
# path — duplicate path entries do not merge.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'none'

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

/deep-v1.json.gz
  Cache-Control: public, max-age=31536000, immutable

# v2 is the live table (append-only); allow it to refresh daily.
/deep-v2.json.gz
  Cache-Control: public, max-age=86400
